{
  "name": "@scroftster/jellyfin-plugin-profanity-filter",
  "version": "1.0.0",
  "description": "Jellyfin plugin for filtering profanity during media playback using real-time speech-to-text and local AI models",
  "author": "scroftster",
  "license": "MIT",
  "jellyfin": {
    "id": "com.scroftster.profanity-filter",
    "name": "Profanity Filter",
    "description": "Filters profanity during media playback using Whisper for speech-to-text and Phi-2 LLM for detection. Supports both mute (pause) and skip (delayed resume) actions.",
    "version": "1.0.0",
    "minimumJellyfinVersion": "10.8.0",
    "logo": "https://raw.githubusercontent.com/scroftster/jellyfin-profanity-filter/main/src/ui/icon.png",
    "screenshots": [
      "https://raw.githubusercontent.com/scroftster/jellyfin-profanity-filter/main/src/ui/screenshots/dashboard.png"
    ],
    "tags": [
      "audio",
      "filter",
      "profanity",
      "whisper",
      "ai"
    ],
    "mediaTags": [],
    "categories": [
      "Audio"
    ]
  },
  "scripts": {
    "build": "tsc && webpack --mode production",
    "dev": "webpack --mode development --watch",
    "start": "node dist/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@jellyfin/sdk": "^1.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jest": "^29.7.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/ui/**/*"
    ]
  }
}
